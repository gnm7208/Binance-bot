# Bybit Spot API credentials
# Get from: https://www.bybit.com/app/user/api-management
# Permissions needed: Read + Trade (Spot)
# IP restriction recommended for live keys
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET_KEY=your_bybit_secret_key_here
BYBIT_BASE_URL=https://api.bybit.com

# Perplexity API (market research)
# Get from: https://www.perplexity.ai/settings/api
# Optional — leave blank to use WebSearch fallback
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar

# ClickUp (notifications — posts to a Chat channel)
# Workspace ID: numeric ID from your ClickUp URL
# Channel ID: format 4-XXXXXXX-X (from the chat channel URL)
CLICKUP_API_KEY=your_clickup_api_key_here
CLICKUP_WORKSPACE_ID=your_workspace_id_here
CLICKUP_CHANNEL_ID=your_channel_id_here
